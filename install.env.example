# Install settings for ./bootstrap.sh. Copy this file to install.env (git-ignored, it holds your keys), fill it in,
# then run ./bootstrap.sh. Values set in install.env win over the same variables in your shell.
#
# The models run outside the cluster, behind any OpenAI-compatible endpoint: a base URL ending in /v1 and an API key.
# Each role may use a different provider. If all three sit behind one endpoint, repeat the same URL and key.

# --- Required -------------------------------------------------------------------------------------------------------

# Agent model, run by both portals. Needs structured tool calls; for Showcase 2's unsecured side to pay out it must
# also obey an instruction hidden in a document (qwen3-14b does).
AGENT_ENDPOINT="https://<agent-provider>/v1"
AGENT_KEY="<agent-api-key>"

# Guard-tier model (registered in MaaS and the model registry; must return logprobs).
GUARD_ENDPOINT="https://<guard-provider>/v1"
GUARD_KEY="<guard-api-key>"

# Evaluation judge (release evaluation and the sampled AgenticOps judge; must follow the scoring JSON format).
JUDGE_ENDPOINT="https://<judge-provider>/v1"
JUDGE_KEY="<judge-api-key>"

# --- Optional: model ids (defaults are the tested models) -----------------------------------------------------------

# AGENT_MODEL=qwen3-14b
# GUARD_MODEL=granite-guardian-3-1-8b
# JUDGE_MODEL=gpt-oss-120b

# --- Optional: where Argo CD reads the repository from (default: this clone's origin, branch main) ------------------

# REPO_URL=https://github.com/<you>/parasol-agent-prod.git
# REPO_REVISION=main

# --- Optional: OpenShift AI version (default channel stable-3.x, pinned CSV rhods-operator.3.5.2) -------------------

# RHOAI_CHANNEL=stable-3.x
# RHOAI_CSV=rhods-operator.3.5.2

# --- Optional: partial runs ---------------------------------------------------------------------------------------

# SKIP_BUILDS=1   # do not start the in-cluster image builds
# SKIP_SEED=1     # skip the demo data (MLflow runs, registry, first release)
