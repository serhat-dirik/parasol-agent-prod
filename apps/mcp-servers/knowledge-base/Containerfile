# Parasol knowledge-base MCP server (Python). Python rather than Quarkus like the other MCP servers because
# the embeddings run in-process on CPU with sentence-transformers. The embedding model (IBM Granite
# embedding 125m English, Apache 2.0, 768 dimensions) is downloaded at BUILD time and baked into the
# image; at run time the pod needs no internet (HF_HUB_OFFLINE=1).
# Same image runs the server (default) and the ingestion job (python3 ingest.py).
FROM registry.access.redhat.com/ubi9/python-312:latest
USER 0
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.8.0 \
 && pip install --no-cache-dir -r requirements.txt
ENV HF_HOME=/opt/models
RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('ibm-granite/granite-embedding-125m-english')" \
 && chmod -R g=u /opt/models
COPY kb/ ./
RUN python3 test_kb.py && chown -R 1001:0 /app && chmod -R g=u /app
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
USER 1001
EXPOSE 8080
CMD ["python3", "server.py"]
